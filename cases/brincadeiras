   try {
                const entrada = GAMES2.games2[commandFinal];
                const midiaUrl = entrada?.video?.url || entrada?.image?.url;

                if (!midiaUrl) {
                    await reply('❌ Mídia não configurada pra esse comando.');
                    break;
                }

                const axios = require('axios');
                const fs = require('fs');
                const path = require('path');
                const { spawn } = require('child_process');

                const res = await axios.get(midiaUrl, {
                    responseType: 'arraybuffer',
                    timeout: 60000,
                    maxContentLength: 50 * 1024 * 1024,
                    headers: {
                        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
                        'Accept': '*/*'
                    }
                });

                const buffer = Buffer.from(res.data);

                if (!buffer || buffer.length < 100) {
                    await reply('❌ Não consegui baixar a mídia.');
                    break;
                }

                // ── detecta tipo real pelos bytes (magic numbers), não confia só na extensão da URL ──
                const hex = buffer.subarray(0, 16).toString('hex').toLowerCase();
                const ehJpg  = hex.startsWith('ffd8ff');
                const ehPng  = hex.startsWith('89504e47');
                const ehWebp = hex.slice(16, 24) === '57454250';
                const ehGif  = hex.startsWith('47494638');
                const ehMp4  = hex.slice(8, 16) === '66747970'; // ftyp
                const ehWebm = hex.startsWith('1a45dfa3');

                const caption = `${emojis[commandFinal] || '🎬'} @${sender.split('@')[0]} ${verbos[commandFinal] || 'fez algo com'} @${alvo.split('@')[0]}!`;

                // ── imagem estática: envia direto, sem ffmpeg ──
                if (ehJpg || ehPng || ehWebp) {
                    await conn.sendMessage(from, {
                        image: buffer,
                        caption,
                        mentions: [sender, alvo]
                    }, { quoted: m });
                    break;
                }

                // ── gif ou vídeo: precisa passar por ffmpeg pra virar mp4 compatível ──
                if (ehGif || ehMp4 || ehWebm) {
                    const tmpDir = getTmpDir(); cleanupOldTempFiles(tmpDir);
                    const baseName = `${commandFinal}_${Date.now()}_${Math.floor(Math.random() * 9999)}`;
                    const extEntrada = ehGif ? 'gif' : (ehWebm ? 'webm' : 'mp4');
                    const inputFile  = path.join(tmpDir, `${baseName}_raw.${extEntrada}`);
                    const outputFile = path.join(tmpDir, `${baseName}.mp4`);

                    fs.writeFileSync(inputFile, buffer);

                    await new Promise((resolve, reject) => {
                        const proc = spawn('ffmpeg', [
                            '-y', '-i', inputFile,
                            '-c:v', 'libx264',
                            '-profile:v', 'baseline',
                            '-level', '3.0',
                            '-pix_fmt', 'yuv420p',
                            '-c:a', 'aac',
                            '-b:a', '128k',
                            '-movflags', '+faststart',
                            '-vf', 'scale=trunc(iw/2)*2:trunc(ih/2)*2',
                            outputFile
                        ], { windowsHide: true });
                        let stderr = '';
                        proc.stderr.on('data', d => { stderr += d.toString(); });
                        proc.on('close', code => code === 0 ? resolve() : reject(new Error(`ffmpeg código ${code}: ${stderr.slice(0, 300)}`)));
                        proc.on('error', reject);
                    });

                    try { fs.unlinkSync(inputFile); } catch (_) {}

                    if (!fs.existsSync(outputFile)) {
                        console.error(`[${commandFinal}] ffmpeg não gerou o arquivo final`);
                        await reply('❌ Erro ao converter a mídia.');
                        break;
                    }

                    const bufferFinal = fs.readFileSync(outputFile);
                    try { fs.unlinkSync(outputFile); } catch (_) {}

                    await conn.sendMessage(from, {
                        video: bufferFinal,
                        mimetype: 'video/mp4',
                        gifPlayback: ehGif, // só marca como "gif" se a fonte realmente era gif
                        caption,
                        mentions: [sender, alvo]
                    }, { quoted: m });
                    break;
                }

                // ── tipo não reconhecido pelos bytes ──
                console.warn(`[${commandFinal}] tipo de mídia não reconhecido, hex:`, hex);
                await reply('❌ Formato de mídia não reconhecido.');

            } catch (err) {
                console.error(`[ERRO ${commandFinal}]:`, err?.message || err);
                await reply('❌ Erro ao buscar/enviar a mídia. Tenta de novo.');
            }
